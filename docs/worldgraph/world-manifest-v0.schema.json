{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saberistic.com/schemas/world-manifest-v0.json",
  "title": "World Manifest v0",
  "description": "Canonical WorldGraph manifest schema (issue #199). Every factual field uses provenance wrappers; unknown values cannot be verified.",
  "type": "object",
  "required": ["schema_version", "identity", "experience", "ai_role", "trust"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "world-manifest-v0"
    },
    "manifest_version": { "$ref": "#/$defs/provenStringOrUnknown" },
    "identity": { "$ref": "#/$defs/identitySection" },
    "experience": { "$ref": "#/$defs/experienceSection" },
    "world_structure": { "$ref": "#/$defs/worldStructureSection" },
    "ai_role": { "$ref": "#/$defs/aiRoleSection" },
    "trust": { "$ref": "#/$defs/trustSection" },
    "discovery": { "$ref": "#/$defs/discoverySection" },
    "linked_entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/linkedEntity" }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Forward-compatible namespace for vendor-specific extensions."
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["source_kind", "confidence", "observed_at"],
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": ["source_observation", "creator_declared", "derived", "unknown"]
        },
        "source_url": { "type": ["string", "null"], "format": "uri" },
        "evidence_snippet": { "type": ["string", "null"], "maxLength": 2000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "verification_status": {
          "type": "string",
          "enum": [
            "unverified",
            "domain_verified",
            "github_verified",
            "email_domain_verified",
            "saberistic_verified"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "source_kind": { "const": "unknown" } },
            "required": ["source_kind"]
          },
          "then": {
            "properties": {
              "confidence": { "const": 0 },
              "verification_status": { "const": "unverified" }
            }
          }
        }
      ]
    },
    "provenString": {
      "type": "object",
      "required": ["value", "provenance"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1, "not": { "const": "unknown" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "provenUrl": {
      "type": "object",
      "required": ["value", "provenance"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "format": "uri" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "provenStringOrUnknown": {
      "oneOf": [
        {
          "type": "object",
          "required": ["value", "provenance"],
          "additionalProperties": false,
          "properties": {
            "value": { "const": "unknown" },
            "provenance": {
              "allOf": [
                { "$ref": "#/$defs/provenance" },
                {
                  "type": "object",
                  "required": ["source_kind", "confidence", "observed_at", "verification_status"],
                  "properties": {
                    "source_kind": { "const": "unknown" },
                    "confidence": { "const": 0 },
                    "verification_status": { "const": "unverified" }
                  }
                }
              ]
            }
          }
        },
        { "$ref": "#/$defs/provenString" }
      ]
    },
    "provenStringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/provenString" }
    },
    "provenStringOrUnknownList": {
      "type": "array",
      "items": { "$ref": "#/$defs/provenStringOrUnknown" }
    },
    "identitySection": {
      "type": "object",
      "required": ["name", "canonical_url", "world_type", "status"],
      "additionalProperties": false,
      "properties": {
        "world_id": { "$ref": "#/$defs/provenStringOrUnknown" },
        "name": { "$ref": "#/$defs/provenString" },
        "canonical_url": { "$ref": "#/$defs/provenUrl" },
        "summary": { "$ref": "#/$defs/provenStringOrUnknown" },
        "status": { "$ref": "#/$defs/provenString" },
        "version": { "$ref": "#/$defs/provenStringOrUnknown" },
        "created_at": { "$ref": "#/$defs/provenStringOrUnknown" },
        "updated_at": { "$ref": "#/$defs/provenStringOrUnknown" },
        "world_type": { "$ref": "#/$defs/provenString" },
        "modalities": { "$ref": "#/$defs/provenStringList" },
        "creator": { "$ref": "#/$defs/provenStringOrUnknown" },
        "operator": { "$ref": "#/$defs/provenStringOrUnknown" },
        "claimed_owner": { "$ref": "#/$defs/provenStringOrUnknown" }
      }
    },
    "experienceSection": {
      "type": "object",
      "required": ["entry_points", "interaction_model", "persistence_model"],
      "additionalProperties": false,
      "properties": {
        "entry_points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenUrl" }
        },
        "supported_devices": { "$ref": "#/$defs/provenStringList" },
        "interaction_model": { "$ref": "#/$defs/provenString" },
        "persistence_model": { "$ref": "#/$defs/provenStringOrUnknown" },
        "access_requirements": { "$ref": "#/$defs/provenStringOrUnknown" },
        "pricing": { "$ref": "#/$defs/provenStringOrUnknown" },
        "availability": { "$ref": "#/$defs/provenStringOrUnknown" },
        "region": { "$ref": "#/$defs/provenStringOrUnknown" },
        "age_guidance": { "$ref": "#/$defs/provenStringOrUnknown" },
        "supported_languages": { "$ref": "#/$defs/provenStringList" },
        "modalities": { "$ref": "#/$defs/provenStringList" }
      }
    },
    "worldStructureSection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setting": { "$ref": "#/$defs/provenStringOrUnknown" },
        "lore_or_canon": { "$ref": "#/$defs/provenStringOrUnknown" },
        "rules_or_mechanics": { "$ref": "#/$defs/provenStringOrUnknown" },
        "state_model": { "$ref": "#/$defs/provenStringOrUnknown" },
        "agents_and_characters": { "$ref": "#/$defs/provenStringOrUnknownList" },
        "assets_and_dependencies": { "$ref": "#/$defs/provenStringOrUnknownList" },
        "platforms": { "$ref": "#/$defs/provenStringOrUnknownList" },
        "engines": { "$ref": "#/$defs/provenStringOrUnknownList" },
        "models": { "$ref": "#/$defs/provenStringOrUnknownList" },
        "protocols": { "$ref": "#/$defs/provenStringOrUnknownList" },
        "economy": { "$ref": "#/$defs/provenStringOrUnknown" },
        "governance": { "$ref": "#/$defs/provenStringOrUnknown" }
      }
    },
    "aiRoleSection": {
      "type": "object",
      "required": ["material_ai_role", "ai_usage_phase"],
      "additionalProperties": false,
      "properties": {
        "material_ai_role": { "$ref": "#/$defs/provenString" },
        "ai_usage_phase": { "$ref": "#/$defs/provenString" },
        "generated_or_controlled_elements": { "$ref": "#/$defs/provenStringList" },
        "model_disclosures": { "$ref": "#/$defs/provenStringOrUnknownList" },
        "human_control_boundaries": { "$ref": "#/$defs/provenStringOrUnknown" }
      }
    },
    "trustSection": {
      "type": "object",
      "required": ["qualification_status", "claim_status"],
      "additionalProperties": false,
      "properties": {
        "qualification_status": {
          "type": "string",
          "enum": ["qualifies", "excluded", "pending_review"]
        },
        "exclusion_reason": { "$ref": "#/$defs/provenStringOrUnknown" },
        "claim_status": {
          "type": "string",
          "enum": [
            "unclaimed",
            "creator_claimed",
            "domain_verified",
            "github_verified",
            "email_domain_verified",
            "saberistic_verified"
          ]
        },
        "license_status": { "$ref": "#/$defs/provenStringOrUnknown" },
        "commercial_use_status": { "$ref": "#/$defs/provenStringOrUnknown" },
        "ip_declarations": { "$ref": "#/$defs/provenStringOrUnknownList" },
        "source_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenUrl" }
        },
        "safety_categories": { "$ref": "#/$defs/provenStringOrUnknownList" },
        "moderation_contact": { "$ref": "#/$defs/provenStringOrUnknown" },
        "data_privacy_notes": { "$ref": "#/$defs/provenStringOrUnknown" },
        "content_rights_notes": { "$ref": "#/$defs/provenStringOrUnknown" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "qualification_status": { "const": "excluded" } },
            "required": ["qualification_status"]
          },
          "then": {
            "required": ["exclusion_reason"]
          }
        }
      ]
    },
    "representativeMedia": {
      "type": "object",
      "required": ["media_url"],
      "additionalProperties": false,
      "properties": {
        "media_url": { "$ref": "#/$defs/provenUrl" },
        "media_type": { "$ref": "#/$defs/provenStringOrUnknown" },
        "c2pa_manifest_url": { "$ref": "#/$defs/provenStringOrUnknown" },
        "c2pa_validation": {
          "oneOf": [
            {
              "type": "object",
              "required": ["value", "provenance"],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "enum": ["valid", "invalid", "unknown"]
                },
                "provenance": { "$ref": "#/$defs/provenance" }
              }
            }
          ]
        }
      }
    },
    "worldReference": {
      "type": "object",
      "required": ["world_id", "relationship"],
      "additionalProperties": false,
      "properties": {
        "world_id": { "$ref": "#/$defs/provenString" },
        "relationship": { "$ref": "#/$defs/provenString" },
        "reference_url": { "$ref": "#/$defs/provenUrl" }
      }
    },
    "discoverySection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tags": { "$ref": "#/$defs/provenStringList" },
        "facets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/provenStringOrUnknown" }
        },
        "representative_media": {
          "type": "array",
          "items": { "$ref": "#/$defs/representativeMedia" }
        },
        "semantic_description": { "$ref": "#/$defs/provenStringOrUnknown" },
        "related_worlds": {
          "type": "array",
          "items": { "$ref": "#/$defs/worldReference" }
        },
        "inspirations": { "$ref": "#/$defs/provenStringOrUnknownList" },
        "forks": {
          "type": "array",
          "items": { "$ref": "#/$defs/worldReference" }
        },
        "imports": { "$ref": "#/$defs/provenStringOrUnknownList" },
        "dependencies": { "$ref": "#/$defs/provenStringOrUnknownList" },
        "primary_call_to_action": { "$ref": "#/$defs/provenStringOrUnknown" }
      }
    },
    "linkedEntity": {
      "type": "object",
      "required": ["entity_type", "entity_id"],
      "additionalProperties": false,
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": [
            "platform",
            "agent",
            "character",
            "creator",
            "organization",
            "asset",
            "engine",
            "model"
          ]
        },
        "entity_id": { "type": "string", "minLength": 1 },
        "display_name": { "$ref": "#/$defs/provenStringOrUnknown" },
        "reference_url": { "$ref": "#/$defs/provenUrl" },
        "external_standard": {
          "type": "string",
          "enum": [
            "a2a_agent_card",
            "mcp_registry",
            "c2pa",
            "gltf",
            "openusd",
            "webxr",
            "msf_web_of_worlds"
          ]
        },
        "external_id": { "$ref": "#/$defs/provenStringOrUnknown" },
        "capabilities": { "$ref": "#/$defs/provenStringList" }
      }
    }
  }
}
