{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saberistic.com/schemas/world-manifest-v0.json",
  "title": "World Manifest v0",
  "description": "Canonical WorldGraph manifest schema (issue #199). Every populated factual field uses the provenance wrapper; unknown values cannot be verified.",
  "type": "object",
  "required": ["schema_version", "identity", "experience", "ai_role", "trust"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "world-manifest-v0"
    },
    "identity": {
      "type": "object",
      "required": ["name", "canonical_url", "world_type", "status"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/provenString" },
        "canonical_url": { "$ref": "#/$defs/provenUrl" },
        "world_id": { "$ref": "#/$defs/provenStringOrUnknown" },
        "world_type": { "$ref": "#/$defs/provenString" },
        "status": { "$ref": "#/$defs/provenString" },
        "summary": { "$ref": "#/$defs/provenStringOrUnknown" },
        "version": { "$ref": "#/$defs/provenStringOrUnknown" },
        "created_at": { "$ref": "#/$defs/provenDateTimeOrUnknown" },
        "updated_at": { "$ref": "#/$defs/provenDateTimeOrUnknown" },
        "modalities": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenString" }
        },
        "creator": { "$ref": "#/$defs/provenStringOrUnknown" },
        "operator": { "$ref": "#/$defs/provenStringOrUnknown" },
        "claimed_owner": { "$ref": "#/$defs/provenStringOrUnknown" }
      }
    },
    "experience": {
      "type": "object",
      "required": ["entry_points", "interaction_model", "persistence_model"],
      "additionalProperties": false,
      "properties": {
        "entry_points": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenUrl" }
        },
        "supported_devices": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenString" }
        },
        "interaction_model": { "$ref": "#/$defs/provenString" },
        "persistence_model": { "$ref": "#/$defs/provenStringOrUnknown" },
        "access_requirements": { "$ref": "#/$defs/provenStringOrUnknown" },
        "pricing_model": { "$ref": "#/$defs/provenStringOrUnknown" },
        "availability": { "$ref": "#/$defs/provenStringOrUnknown" },
        "region_restrictions": { "$ref": "#/$defs/provenStringOrUnknown" },
        "age_guidance": { "$ref": "#/$defs/provenStringOrUnknown" },
        "supported_languages": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenString" }
        }
      }
    },
    "world_structure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setting": { "$ref": "#/$defs/provenStringOrUnknown" },
        "lore_or_canon": { "$ref": "#/$defs/provenStringOrUnknown" },
        "rules_or_mechanics": { "$ref": "#/$defs/provenStringOrUnknown" },
        "state_model": { "$ref": "#/$defs/provenStringOrUnknown" },
        "agents_and_characters": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenStringOrUnknown" }
        },
        "assets_and_dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenStringOrUnknown" }
        },
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenStringOrUnknown" }
        },
        "engines": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenStringOrUnknown" }
        },
        "models": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenStringOrUnknown" }
        },
        "protocols": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenStringOrUnknown" }
        },
        "economy": { "$ref": "#/$defs/optionalDescriptionBlock" },
        "governance": { "$ref": "#/$defs/optionalDescriptionBlock" }
      }
    },
    "ai_role": {
      "type": "object",
      "required": ["material_ai_role", "ai_usage_phase"],
      "additionalProperties": false,
      "properties": {
        "material_ai_role": { "$ref": "#/$defs/provenString" },
        "ai_usage_phase": { "$ref": "#/$defs/provenString" },
        "build_time_ai_use": { "$ref": "#/$defs/provenStringOrUnknown" },
        "runtime_ai_use": { "$ref": "#/$defs/provenStringOrUnknown" },
        "generated_or_agent_controlled_elements": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenStringOrUnknown" }
        },
        "model_disclosures": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenStringOrUnknown" }
        },
        "human_control_boundaries": { "$ref": "#/$defs/provenStringOrUnknown" },
        "moderation_boundaries": { "$ref": "#/$defs/provenStringOrUnknown" }
      }
    },
    "trust": {
      "type": "object",
      "required": ["qualification_status", "claim_status"],
      "additionalProperties": false,
      "properties": {
        "qualification_status": {
          "type": "string",
          "enum": ["qualifies", "excluded", "pending_review"]
        },
        "exclusion_reason": {
          "type": "string",
          "enum": [
            "static_ai_media_only",
            "single_purpose_assistant",
            "foundation_model_not_world",
            "platform_product_not_world",
            "no_stable_entry_point",
            "marketing_only",
            "dataset_or_tool_only",
            "unaddressable_demo"
          ]
        },
        "claim_status": {
          "type": "string",
          "enum": [
            "unclaimed",
            "creator_claimed",
            "domain_verified",
            "github_verified",
            "email_domain_verified",
            "saberistic_verified"
          ]
        },
        "license_status": { "$ref": "#/$defs/provenStringOrUnknown" },
        "commercial_use_status": { "$ref": "#/$defs/provenStringOrUnknown" },
        "ip_rightsholder_declarations": { "$ref": "#/$defs/provenStringOrUnknown" },
        "provenance_and_source_evidence": { "$ref": "#/$defs/provenStringOrUnknown" },
        "safety_categories": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenStringOrUnknown" }
        },
        "moderation_contact": { "$ref": "#/$defs/provenStringOrUnknown" },
        "data_privacy_considerations": { "$ref": "#/$defs/provenStringOrUnknown" },
        "content_rights_notes": { "$ref": "#/$defs/provenStringOrUnknown" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "qualification_status": { "const": "excluded" } },
            "required": ["qualification_status"]
          },
          "then": { "required": ["exclusion_reason"] }
        }
      ]
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenString" }
        },
        "structured_facets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/provenStringOrUnknown" }
        },
        "semantic_description": { "$ref": "#/$defs/provenStringOrUnknown" },
        "representative_media": {
          "type": "array",
          "items": { "$ref": "#/$defs/mediaItem" }
        },
        "related_worlds": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenUrl" }
        },
        "inspirations": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenStringOrUnknown" }
        },
        "forks": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenUrl" }
        },
        "imports": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenStringOrUnknown" }
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenStringOrUnknown" }
        },
        "primary_calls_to_action": {
          "type": "array",
          "items": { "$ref": "#/$defs/provenString" }
        },
        "primary_call_to_action": { "$ref": "#/$defs/provenStringOrUnknown" }
      }
    },
    "entity_links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platforms": {
          "type": "array",
          "items": { "$ref": "#/$defs/entityRef" }
        },
        "agents": {
          "type": "array",
          "items": { "$ref": "#/$defs/entityRef" }
        },
        "creators": {
          "type": "array",
          "items": { "$ref": "#/$defs/entityRef" }
        },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/entityRef" }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["source_kind", "confidence", "observed_at"],
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "source_observation",
            "creator_declared",
            "derived",
            "unknown"
          ]
        },
        "source_url": { "type": ["string", "null"], "format": "uri" },
        "evidence_snippet": { "type": ["string", "null"], "maxLength": 2000 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "verification_status": {
          "type": "string",
          "enum": [
            "unverified",
            "domain_verified",
            "github_verified",
            "email_domain_verified",
            "saberistic_verified"
          ]
        }
      }
    },
    "unknownProvenance": {
      "allOf": [
        { "$ref": "#/$defs/provenance" },
        {
          "type": "object",
          "properties": {
            "source_kind": { "const": "unknown" },
            "confidence": { "const": 0 },
            "verification_status": { "const": "unverified" }
          },
          "required": ["source_kind", "confidence", "verification_status"]
        }
      ]
    },
    "provenString": {
      "type": "object",
      "required": ["value", "provenance"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "minLength": 1, "not": { "const": "unknown" } },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "provenUrl": {
      "type": "object",
      "required": ["value", "provenance"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "format": "uri" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "provenDateTime": {
      "type": "object",
      "required": ["value", "provenance"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "format": "date-time" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "provenStringOrUnknown": {
      "oneOf": [
        {
          "type": "object",
          "required": ["value", "provenance"],
          "additionalProperties": false,
          "properties": {
            "value": { "const": "unknown" },
            "provenance": { "$ref": "#/$defs/unknownProvenance" }
          }
        },
        { "$ref": "#/$defs/provenString" }
      ]
    },
    "provenDateTimeOrUnknown": {
      "oneOf": [
        {
          "type": "object",
          "required": ["value", "provenance"],
          "additionalProperties": false,
          "properties": {
            "value": { "const": "unknown" },
            "provenance": { "$ref": "#/$defs/unknownProvenance" }
          }
        },
        { "$ref": "#/$defs/provenDateTime" }
      ]
    },
    "optionalDescriptionBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": { "$ref": "#/$defs/provenStringOrUnknown" },
        "details": { "$ref": "#/$defs/provenStringOrUnknown" }
      }
    },
    "mediaItem": {
      "type": "object",
      "required": ["media_url", "media_type"],
      "additionalProperties": false,
      "properties": {
        "media_url": { "$ref": "#/$defs/provenUrl" },
        "media_type": { "$ref": "#/$defs/provenString" },
        "caption": { "$ref": "#/$defs/provenStringOrUnknown" },
        "c2pa_manifest_url": { "$ref": "#/$defs/provenUrl" },
        "c2pa_active_manifest": { "$ref": "#/$defs/provenStringOrUnknown" }
      }
    },
    "entityRef": {
      "type": "object",
      "required": ["entity_type", "label", "url", "provenance"],
      "additionalProperties": false,
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": ["platform", "agent", "character", "creator", "organization", "asset", "ip"]
        },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "external_standard": {
          "type": "string",
          "enum": ["a2a_agent_card", "mcp_registry", "c2pa", "gltf", "usd", "webxr", "other"]
        }
      }
    }
  }
}
