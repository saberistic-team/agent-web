{
  "schema_version": 2,
  "protected_paths": [
    {
      "path": ".github/workflows/**",
      "category": "GitHub Actions workflows"
    },
    {
      "path": "scripts/github_api.py",
      "category": "control-plane orchestration",
      "privilege": "Shared GitHub REST and Git Data API helpers for every agent workflow."
    },
    {
      "path": "scripts/dispatch_queue.py",
      "category": "control-plane orchestration",
      "privilege": "Dispatches queued issues, mutates priority and agent labels."
    },
    {
      "path": "scripts/copilot_agent.py",
      "category": "control-plane orchestration",
      "privilege": "Copilot agent assignment and review adapters (dormant but privileged)."
    },
    {
      "path": "scripts/require_planner_plan.py",
      "category": "control-plane orchestration",
      "privilege": "Fail-closed Planner gate before queue release."
    },
    {
      "path": "scripts/priority.py",
      "category": "control-plane orchestration",
      "privilege": "Priority label resolution and inference for dispatch."
    },
    {
      "path": "scripts/project_sync.py",
      "category": "control-plane orchestration",
      "privilege": "GraphQL project board sync from orchestration labels."
    },
    {
      "path": "scripts/milestones.py",
      "category": "control-plane orchestration",
      "privilege": "Milestone assignment and eligibility via GitHub API."
    },
    {
      "path": "scripts/cursor_model.py",
      "category": "control-plane orchestration",
      "privilege": "Model selection for review, codegen, and post-deploy visual."
    },
    {
      "path": "scripts/review_*.py",
      "category": "reviewer automation"
    },
    {
      "path": "scripts/review_decision.py",
      "category": "reviewer automation"
    },
    {
      "path": "scripts/acceptance.py",
      "category": "reviewer automation"
    },
    {
      "path": "scripts/check_permission.py",
      "category": "reviewer automation"
    },
    {
      "path": "scripts/pr_labels.py",
      "category": "reviewer automation"
    },
    {
      "path": "scripts/run_agent.py",
      "category": "reviewer and Builder orchestration"
    },
    {
      "path": "scripts/write_trace.py",
      "category": "reviewer and Builder audit trail"
    },
    {
      "path": "scripts/codegen_*.py",
      "category": "Builder configuration"
    },
    {
      "path": "scripts/builder_conflicts.py",
      "category": "Builder configuration"
    },
    {
      "path": "scripts/cursor_sdk_patch.py",
      "category": "Builder configuration"
    },
    {
      "path": "scripts/screenshot_deploy.py",
      "category": "reviewer automation",
      "privilege": "Captures screenshots and commits via Git Data API."
    },
    {
      "path": "scripts/render_deploy.py",
      "category": "deploy and production gates",
      "privilege": "Triggers production Render deploy."
    },
    {
      "path": "scripts/freeze_shipped_migrations.py",
      "category": "deploy and production gates",
      "privilege": "Commits migration freeze digests to main after deploy."
    },
    {
      "path": "scripts/post_deploy_visual.py",
      "category": "deploy and production gates",
      "privilege": "Post-deploy visual checks and GitHub comments."
    },
    {
      "path": "AGENTS/**",
      "category": "Builder prompts and repository policy"
    },
    {
      "path": ".github/copilot-instructions.md",
      "category": "Builder prompts and repository policy"
    },
    {
      "path": "docs/WORKFLOW_GOVERNANCE.md",
      "category": "repository policy"
    },
    {
      "path": "docs/IDENTITIES.md",
      "category": "repository policy"
    },
    {
      "path": "docs/LABELS.md",
      "category": "repository policy"
    },
    {
      "path": ".github/CODEOWNERS",
      "category": "repository policy"
    },
    {
      "path": ".github/workflow-governance-paths.json",
      "category": "repository policy"
    },
    {
      "path": ".github/rulesets/**",
      "category": "repository policy"
    },
    {
      "path": "scripts/validate_workflow_governance.py",
      "category": "repository policy"
    },
    {
      "path": "tests/test_workflow_governance.py",
      "category": "repository policy"
    }
  ],
  "workflow_entrypoint_exemptions": [
    {
      "path": "scripts/check_coverage.py",
      "reason": "Read-only pytest coverage gate; no GitHub, dispatch, or deploy mutations."
    },
    {
      "path": "scripts/digest_trace.py",
      "reason": "Read-only trace summarization; GitHub posting is handled by gh in the workflow."
    }
  ],
  "dynamic_script_imports": {
    "scripts/run_agent.py": [
      "scripts/screenshot_deploy.py"
    ]
  }
}
